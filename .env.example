# Project Environment Configuration

# Django Backend
DJANGO_SECRET_KEY=change-this-in-production-to-a-secure-random-key
DEBUG=True
ALLOWED_HOSTS=*
DATABASE_URL=postgres://user:password@localhost:5432/weather_routing

# External APIs
# OpenRouteService API Key (optional - system falls back to OSRM + smart corridor routing if not supplied)
OPENROUTESERVICE_API_KEY=

# Geocoding API Key (optional - system uses OpenStreetMap Nominatim with no key needed)
GEOCODING_API_KEY=

# Weather API Key (optional - system uses Open-Meteo with no key needed)
WEATHER_API_KEY=

# Frontend Configuration
VITE_API_BASE_URL=http://127.0.0.1:8000

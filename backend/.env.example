# Django Configuration
DJANGO_SECRET_KEY=your-secret-key-here-generate-random-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,*

# Database (Leave empty for SQLite, or provide PostgreSQL connection string)
# DATABASE_URL=postgres://user:password@localhost:5432/weather_routing

# External APIs
# Routing API (OpenRouteService - optional, falls back to OSRM + smart corridor routing if not provided)
OPENROUTESERVICE_API_KEY=

# Geocoding API (Optional, defaults to OpenStreetMap Nominatim with zero key required)
GEOCODING_API_KEY=

# Weather API (Open-Meteo is keyless and free)
WEATHER_API_KEY=
